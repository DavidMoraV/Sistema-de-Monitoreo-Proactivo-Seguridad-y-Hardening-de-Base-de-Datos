# =====================================================================
#  .env.example — plantilla SIN credenciales reales.
#  El .env real se genera en el servidor con: bash scripts/preparar_entorno.sh
#  NUNCA subir el .env a GitHub (está en .gitignore).
# =====================================================================

# --- Servidor ---
SERVIDOR_IP=192.168.56.102
GENERIC_TIMEZONE=America/Costa_Rica

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__cambiar__
POSTGRES_DB=nutrianimales_db
AGENTE_IA_PASSWORD=__cambiar__
MONITOR_N8N_PASSWORD=__cambiar__
GERENTE_DB_PASSWORD=__cambiar__
TI_DB_PASSWORD=__cambiar__
AUDITOR_DB_PASSWORD=__cambiar__

# --- N8N ---
N8N_PASSWORD=__cambiar__
N8N_ENCRYPTION_KEY=__cambiar__

# --- Telegram (M3) ---
TELEGRAM_BOT_TOKEN=__cambiar__
TELEGRAM_CHAT_ID=__cambiar__

# --- Groq (M3) ---
GROQ_API_KEY=__cambiar__

# --- Proyecto II: compose combinado (permite usar solo "docker compose up -d") ---
COMPOSE_FILE=docker-compose.yml:docker-compose.logs.yml:docker-compose.glpi.yml

# --- Proyecto II: GLPI y su base de datos (GLPI queda en https://<SERVIDOR_IP>:8444) ---
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=__cambiar__
# Se generan dentro de GLPI (Configuración → General → API y Administración → Usuarios → n8n)
GLPI_APP_TOKEN=__cambiar__
GLPI_USER_TOKEN=__cambiar__
# IDs que se ven en la URL de GLPI al abrir cada elemento (0 = no se usa)
GLPI_CATEGORIA_ID=0
GLPI_SLA_CRITICO_ID=0

# --- Proyecto II: script de hash de sshd_config (scripts/hash_sshd.sh) ---
# nutrianimales.local es el nombre del certificado de Nginx: así curl valida el certificado.
# El script lo resuelve a 127.0.0.1 si el nombre no existe en el DNS (corre en el mismo servidor).
N8N_WEBHOOK_URL=https://nutrianimales.local:8443/webhook/hash-sshd
# Secreto compartido entre el script y el webhook de N8N (generar con: openssl rand -hex 24)
HASH_WEBHOOK_TOKEN=__cambiar__
HOST_NAME=nutrianimales-srv01
SSHD_CONFIG_PATH=/etc/ssh/sshd_config
# true solo si el certificado autofirmado no coincide con la URL del webhook
N8N_TLS_INSECURE=false

# --- Proyecto II: alerta C3 (minutos para considerar vencido el SLA; 60 en operación, 2 para la demo) ---
C3_UMBRAL_MINUTOS=60
