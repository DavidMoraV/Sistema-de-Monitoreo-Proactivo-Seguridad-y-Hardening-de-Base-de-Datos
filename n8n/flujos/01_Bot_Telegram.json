    {
      "parameters": {
        "jsCode": "// Lee el último update procesado (memoria del flujo) para pedirle a Telegram solo lo nuevo.\nconst sd = $getWorkflowStaticData('global');\nreturn [{ json: { offset: sd.offset || 0 } }];\n"
      },
      "id": "1ae45f5a-5aa4-4953-8037-04b80028a8a6",
      "name": "Leer offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
