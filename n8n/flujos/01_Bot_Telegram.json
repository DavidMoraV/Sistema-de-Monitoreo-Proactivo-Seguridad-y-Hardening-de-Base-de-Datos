      "id": "c236d68f-5e37-4233-9111-1df250cd9223",
      "name": "Ejecutar SQL (agente_ia)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2420,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgAgenteIA000001",
          "name": "Postgres agente_ia"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Arma la petición a Groq para explicar el resultado en lenguaje natural.\nconst pregunta = $('Filtro anti-SQLi (M5)').first().json.texto;\nconst sql = $('Validar SQL (solo SELECT)').first().json.sql_original;\nconst filas = $input.all().map(i => i.json).filter(r => Object.keys(r).length > 0);\nlet resultado;\nif (filas.length === 1 && filas[0].error) {\n  resultado = 'ERROR al ejecutar: ' + (filas[0].error.message || JSON.stringify(filas[0].error));\n} else {\n  resultado = JSON.stringify(filas).slice(0, 6000);\n}\nconst body = {\n  model: 'openai/gpt-oss-120b',\n  reasoning_effort: 'low',\n  temperature: 0.2,\n  max_tokens: 2000,\n  messages: [\n    { role: 'system', content: 'Eres el asistente de datos de NutriAnimales S.A. Responde en español, breve y claro, usando SOLO los resultados entregados. Si hubo error o no hay filas, dilo con honestidad. No inventes datos.' },\n    { role: 'user', content: `Pregunta: ${pregunta}\\nSQL ejecutado: ${sql}\\nResultado (JSON): ${resultado}` }\n  ]\n};\nreturn [{ json: { body } }];\n"
      },
