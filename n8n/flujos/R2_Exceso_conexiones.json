    {
      "parameters": {
        "jsCode": "\n// La anti-repetición (misma alerta en 10 min) la hace Enviar_Alerta consultando alertas_auditoria.\n// (En N8N 2.x la memoria del flujo no se conserva entre ejecuciones de flujos publicados.)\nfunction primeraVez() { return true; }\n\n// R2: más de 10 conexiones activas\nconst UMBRAL = 10;\nconst r = $input.first().json;\nif (!(r.conexiones > UMBRAL)) return [];\nif (!primeraVez('R2')) return [];\nreturn [{ json: {\n  codigo: 'R2',\n  severidad: 'ADVERTENCIA',\n  tipo: 'Exceso de conexiones activas',\n  tabla: 'pg_stat_activity',\n  detalle: `Conexiones activas: ${r.conexiones} (umbral: ${UMBRAL}). Usuarios: ${r.usuarios}`,\n  query: \"SELECT count(*) FROM pg_stat_activity WHERE backend_type = 'client backend'\",\n  usuario: r.usuarios,\n  accion: 'Identificar el origen de las conexiones y terminar las sesiones innecesarias (pg_terminate_backend).'\n}}];\n"
      },
