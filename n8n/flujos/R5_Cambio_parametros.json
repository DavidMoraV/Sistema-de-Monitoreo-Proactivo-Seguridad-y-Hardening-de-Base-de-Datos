    {
      "parameters": {
        "jsCode": "// R5: cualquier cambio de parámetros respecto a la foto anterior.\n// El nodo anterior ya refrescó la foto, así que el mismo cambio no se vuelve a alertar.\n// La primera vez que corre, la foto se llena (si estaba vacía) y no alerta.\nconst cambios = $('Consultar PostgreSQL').all().map(i => i.json).filter(r => r.name);\nif (cambios.length === 0) return [];\nreturn [{ json: {\n  codigo: 'R5',\n  severidad: 'ADVERTENCIA',\n  tipo: 'Cambio de parámetros de configuración',\n  tabla: 'vw_settings_servidor',\n  detalle: 'Cambios: ' + cambios.map(c => `${c.name}: ${c.antes} → ${c.ahora}`).join('; '),\n  query: 'ALTER SYSTEM / postgresql.conf',\n  usuario: 'N/A (revisar log de PostgreSQL)',\n  accion: 'Confirmar que el cambio estaba aprobado; si no, revertir con ALTER SYSTEM RESET y pg_reload_conf().'\n}}];\n"
      },
